# ============================================================
# WebSolutions Studio — Environment Variables
# Copy this file to ".env" locally, or add real values in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets to git or paste them into chat.
# ============================================================

# --- Server-only (used by api/contact.ts — never exposed to the browser) ---
# Create a Resend API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient for inquiry and appointment notifications.
# Optional: the server defaults to ronitsundrani0104@gmail.com if omitted.
OWNER_EMAIL=ronitsundrani0104@gmail.com

# Required: sender address on a domain verified in Resend.
# Replace this example with an address on a domain you own and have verified.
FROM_EMAIL=inquiries@your-verified-domain.com

# Optional: set to "true" to automatically email the customer a confirmation
SEND_CUSTOMER_CONFIRMATION=false

# --- Frontend (safe to expose — no secrets) ---
# Public contact address shown in the footer / contact section.
VITE_OWNER_EMAIL=ronitsundrani0104@gmail.com
