# ============================================================
# WebSolutions Studio — Environment Variables
# Copy this file to ".env" locally, or set these in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets to git.
# ============================================================

# --- Server-only (used by api/contact.ts — never exposed to the browser) ---
# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email address that receives "New Project Inquiry" notifications
OWNER_EMAIL=hello@websolutionsstudio.com

# Verified sender address in Resend (must be a domain you own & verified in Resend)
FROM_EMAIL=inquiries@websolutionsstudio.com

# Optional: set to "true" to automatically email the customer a confirmation
SEND_CUSTOMER_CONFIRMATION=false

# --- Frontend (safe to expose — no secrets) ---
# Public contact email shown in the footer / contact section
VITE_OWNER_EMAIL=hello@websolutionsstudio.com
